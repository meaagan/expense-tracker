<h1>Your Budgets</h1>

<p><%= link_to "New Budget", new_budget_path %></p>

<% if @budgets.any? %>
  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Income / month</th>
        <th>Period</th>
        <th colspan="3"></th>
      </tr>
    </thead>
    <tbody>
      <% @budgets.each do |budget| %>
        <tr>
          <td><%= link_to budget.title, budget_path(budget) %></td>
          <td><%= number_to_currency(budget.income_per_month) %></td>
          <td><%= budget.period_start.strftime("%B %Y") %></td>
          <td><%= link_to "Edit", edit_budget_path(budget) %></td>
          <td><%= link_to "Delete", budget_path(budget), method: :delete, data: { turbo_confirm: "Delete this budget?" } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No budgets yet. <%= link_to "Create your first budget", new_budget_path %>.</p>
<% end %>
