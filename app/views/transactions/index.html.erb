<h1>Transactions</h1>

<p><%= link_to "New transaction", new_transaction_path %></p>

<% if @transactions.any? %>
  <table>
    <thead>
      <tr>
        <th><%= link_to "Name", transactions_path(sort: "name", direction: sort_column == "name" && sort_direction == "asc" ? "desc" : "asc") %></th>
        <th><%= link_to "Category", transactions_path(sort: "category", direction: sort_column == "category" && sort_direction == "asc" ? "desc" : "asc") %></th>
        <th><%= link_to "Amount", transactions_path(sort: "amount", direction: sort_column == "amount" && sort_direction == "asc" ? "desc" : "asc") %></th>
        <th><%= link_to "Date", transactions_path(sort: "date", direction: sort_column == "date" && sort_direction == "asc" ? "desc" : "asc") %></th>
        <th colspan="3"></th>
      </tr>
    </thead>
    <tbody>
      <% @transactions.each do |transaction| %>
        <tr>
          <td><%= transaction.name %></td>
          <td><%= transaction.category.to_s.titleize %></td>
          <td><%= number_to_currency(transaction.amount) %></td>
          <td><%= transaction.date&.strftime("%Y-%m-%d") %></td>
          <td><%= link_to "Show", transaction_path(transaction) %></td>
          <td><%= link_to "Edit", edit_transaction_path(transaction) %></td>
          <td>
            <%= link_to "Delete", transaction_path(transaction), data: { turbo_method: :delete, turbo_confirm: "Delete this transaction?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No transactions yet. <%= link_to "Add one", new_transaction_path %>.</p>
<% end %>
