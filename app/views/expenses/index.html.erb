<h1>Expenses</h1>

<p><%= link_to "New expense", new_expense_path %></p>

<% if @expenses.any? %>
  <table>
    <thead>
      <tr>
        <th><%= link_to "Name", expenses_path(sort: "name", direction: sort_column == "name" && sort_direction == "asc" ? "desc" : "asc") %></th>
        <th><%= link_to "Category", expenses_path(sort: "category", direction: sort_column == "category" && sort_direction == "asc" ? "desc" : "asc") %></th>
        <th><%= link_to "Amount", expenses_path(sort: "amount", direction: sort_column == "amount" && sort_direction == "asc" ? "desc" : "asc") %></th>
        <th><%= link_to "Date", expenses_path(sort: "date", direction: sort_column == "date" && sort_direction == "asc" ? "desc" : "asc") %></th>
        <th colspan="3"></th>
      </tr>
    </thead>
    <tbody>
      <% @expenses.each do |expense| %>
        <tr>
          <td><%= expense.name %></td>
          <td><%= expense.category.to_s.titleize %></td>
          <td><%= number_to_currency(expense.amount) %></td>
          <td><%= expense.date&.strftime("%Y-%m-%d") %></td>
          <td><%= link_to "Show", expense_path(expense) %></td>
          <td><%= link_to "Edit", edit_expense_path(expense) %></td>
          <td>
            <%= link_to "Delete", expense_path(expense), data: { turbo_method: :delete, turbo_confirm: "Delete this expense?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No expenses yet. <%= link_to "Add one", new_expense_path %>.</p>
<% end %>
